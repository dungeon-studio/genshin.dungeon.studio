{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["**/.env*", "pnpm-lock.yaml", "pnpm-workspace.yaml"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": [
        "src/**",
        "public/**",
        "package.json",
        "vite.config.*",
        "index.html",
        "tsconfig*.json"
      ],
      "outputs": ["dist/**", ".next/**", "build/**"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "lint": {
      "inputs": ["**/*.{ts,tsx}", "package.json", "eslint.config.*"]
    },
    "test": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "package.json", "vite.config.*", "vitest.config.*", "tsconfig*.json"],
      "env": ["FAST_CHECK_SEED"]
    },
    "test:e2e": {
      "dependsOn": ["^build", "@genshin/api#build"],
      "cache": false
    },
    "test:deployed": {
      "dependsOn": ["^build"],
      "cache": false,
      "passThroughEnv": ["E2E_BASE_URL", "CI"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "inputs": [
        "src/**/*.{ts,tsx}",
        "specs/**/*.ts",
        "package.json",
        "vite.config.*",
        "playwright.config.*",
        "tsconfig*.json"
      ]
    },
    "schemas:export": {
      "dependsOn": ["^build"],
      "inputs": ["src/**/schemas/**", "scripts/export-schemas.ts", "scripts/schema-registry.ts"],
      "outputs": ["schema-snapshots/**"]
    },
    "clean": {
      "cache": false
    }
  }
}
