{
  "$schema": "https://unpkg.com/knip@6/schema.json",

  // `reuse` is a Python tool installed via scripts/install-reuse.sh, not an npm
  // package; the `reuse:check` script invokes it as a binary knip can't resolve.
  "ignoreBinaries": ["reuse"],

  "workspaces": {
    ".": {
      // `turbo gen` discovers its generator by path, so knip sees no importer.
      "entry": ["turbo/generators/config.ts"],
      // These run at the repo root via pre-commit, which knip can't see. eslint
      // hides from knip's eslint plugin too: the flat configs live in each
      // workspace, so the plugin never activates at the root to claim it.
      "ignoreDependencies": ["stylelint", "syncpack", "eslint"]
    },
    "apps/api": {
      // verify-deployment.ts is invoked from deploy.yml, so knip can't see it.
      // The schemas:* scripts are auto-detected from their package.json entries.
      "entry": ["scripts/verify-deployment.ts"],
      // knip's vitest plugin recognises only the conventional config name;
      // listing the integration config reaches its setup file and specs.
      "vitest": {
        "config": ["vitest.config.ts", "vitest.integration.config.ts"]
      }
    },
    "apps/web": {
      // The shadcn kit is vendored with its upstream surface intact, so an
      // export the app hasn't reached for yet isn't dead code.
      "entry": ["src/components/ui/**"]
    }
  }
}
