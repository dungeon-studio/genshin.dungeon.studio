{
  "name": "genshin-dungeon-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Team building companion for Genshin Impact",
  "keywords": [
    "genshin-impact",
    "team-builder",
    "ai",
    "claude",
    "gaming",
    "companion-app"
  ],
  "author": "Alex Brandt <alunduil@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/dungeon-studio/genshin.dungeon.studio#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/dungeon-studio/genshin.dungeon.studio.git"
  },
  "bugs": {
    "url": "https://github.com/dungeon-studio/genshin.dungeon.studio/issues"
  },
  "scripts": {
    "dev": "firebase emulators:exec --only auth,firestore --ui --project demo-dungeon-studio-genshin-dev \"turbo run dev\"",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "knip": "knip",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean",
    "reuse:check": "reuse lint",
    "vscode-extensions:check": "tsx scripts/check-vscode-extensions.ts"
  },
  "devDependencies": {
    "@ls-lint/ls-lint": "2.3.1",
    "@turbo/gen": "2.11.7",
    "@types/node": "24.19.2",
    "eslint": "10.12.0",
    "firebase-tools": "15.33.0",
    "knip": "6.41.0",
    "prettier": "3.9.9",
    "prettier-plugin-tailwindcss": "0.8.1",
    "stylelint": "17.16.0",
    "syncpack": "15.3.3",
    "tsx": "4.23.15",
    "turbo": "2.11.7",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vitest": "5.0.3"
  },
  "packageManager": "pnpm@12.11.1",
  "engines": {
    "node": "24.21.0"
  }
}
