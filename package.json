{
  "name": "genshin-dungeon-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Team building companion for Genshin Impact",
  "keywords": [
    "genshin-impact",
    "team-builder",
    "ai",
    "claude",
    "gaming",
    "companion-app"
  ],
  "author": "Alex Brandt <alunduil@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/dungeon-studio/genshin.dungeon.studio#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/dungeon-studio/genshin.dungeon.studio.git"
  },
  "bugs": {
    "url": "https://github.com/dungeon-studio/genshin.dungeon.studio/issues"
  },
  "scripts": {
    "dev": "firebase emulators:exec --only auth,firestore --ui --project demo-dungeon-studio-genshin-dev \"turbo run dev\"",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "lint:names": "ls-lint",
    "knip": "knip",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean",
    "reuse:check": "reuse lint",
    "vscode-extensions:check": "tsx scripts/check-vscode-extensions.ts"
  },
  "devDependencies": {
    "@ls-lint/ls-lint": "2.3.1",
    "@types/node": "25.9.5",
    "eslint": "10.8.1",
    "firebase-tools": "15.26.0",
    "knip": "6.32.0",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1",
    "stylelint": "17.14.1",
    "syncpack": "15.3.3",
    "tsx": "4.23.12",
    "turbo": "2.10.9",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vitest": "4.1.10"
  },
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": "26.7.0"
  }
}
