{
  "name": "genshin-dungeon-studio",
  "version": "0.1.0",
  "private": true,
  "description": "Team building companion for Genshin Impact",
  "keywords": [
    "genshin-impact",
    "team-builder",
    "ai",
    "claude",
    "gaming",
    "companion-app"
  ],
  "author": "Alex Brandt <alunduil@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/dungeon-studio/genshin.dungeon.studio#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/dungeon-studio/genshin.dungeon.studio.git"
  },
  "bugs": {
    "url": "https://github.com/dungeon-studio/genshin.dungeon.studio/issues"
  },
  "scripts": {
    "dev": "firebase emulators:exec --only auth,firestore --ui --project demo-dungeon-studio-genshin-dev \"turbo run dev\"",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "lint:names": "ls-lint",
    "knip": "knip",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean",
    "reuse:check": "reuse lint",
    "validate:workspace": "tsx scripts/validate-workspace.ts",
    "validate": "pnpm lint && pnpm typecheck && pnpm knip && pnpm reuse:check && pnpm validate:workspace"
  },
  "devDependencies": {
    "@ls-lint/ls-lint": "2.3.1",
    "@types/node": "25.9.5",
    "eslint": "10.8.0",
    "firebase-tools": "15.25.1",
    "knip": "6.31.0",
    "prettier": "3.9.6",
    "stylelint": "17.14.1",
    "stylelint-config-standard": "40.0.0",
    "syncpack": "15.3.2",
    "tsx": "4.23.4",
    "turbo": "2.10.8",
    "typescript": "npm:@typescript/typescript6@6.0.2"
  },
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": "26.6.0"
  }
}
