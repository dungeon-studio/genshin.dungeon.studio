{
  // SPDX-FileCopyrightText: 2026 Alex Brandt <alunduil@gmail.com>
  // SPDX-License-Identifier: MIT
  "name": "Genshin Planner",
  "image": "mcr.microsoft.com/devcontainers/typescript-node:24@sha256:e1fd824e03c68d8f406ef45b574023a2d683a5acc98906743f8d60aaf78b0174",

  "features": {
    // renovate: tag=1
    "ghcr.io/devcontainers/features/github-cli@sha256:bd7ab48a832228f633239277552c30b353867fef2e5b037e064b4e64f0b843f2": {},
    // renovate: tag=1
    "ghcr.io/devcontainers-extra/features/mise@sha256:5c389ab1e3c8e44e5e0ff119f6868d54dbb781bc860bd8587dc66209cb8c4a8c": {},
    // renovate: tag=1
    "ghcr.io/devcontainers/features/docker-outside-of-docker@sha256:661b0fd4c57a7e0bd14d99701ab9bc824719678a9319118728f8d9c59441b7e4": {
      "moby": false
    },
    // renovate: tag=2
    "ghcr.io/devcontainers-extra/features/pre-commit@sha256:6e0bb2ce80caca1d94f44dab5d0653d88a1c00984e590adb7c6bce012d0ade6e": {}
  },

  "customizations": {
    "vscode": {
      // MAINTENANCE: Keep this list in sync with .vscode/extensions.json
      "extensions": [
        // Language support
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",

        // TypeScript enhancements
        "yoavbls.pretty-ts-errors",

        // Shell scripts
        "timonwong.shellcheck",
        "foxundermoon.shell-format",

        // Documentation
        "chrischinchilla.vale-vscode",

        // Developer experience
        "usernamehw.errorlens",
        "eamodio.gitlens",
        "streetsidesoftware.code-spell-checker",
        "meganrogge.template-string-converter",

        // Styling
        "bradlc.vscode-tailwindcss",

        // Containerization
        "ms-azuretools.vscode-docker",

        // Infrastructure as Code
        "hashicorp.terraform",

        // Testing (when Vitest is fully configured)
        "vitest.explorer",

        // API testing
        "rangav.vscode-thunder-client"
      ]
    }
  },

  "forwardPorts": [5173, 8080, 9099],
  "portsAttributes": {
    "5173": {
      "label": "Frontend (Vite)",
      "onAutoForward": "notify"
    },
    "8080": {
      "label": "Backend (Hono)",
      "onAutoForward": "notify"
    },
    "9099": {
      "label": "Firebase Auth Emulator",
      "onAutoForward": "silent"
    }
  },

  "postCreateCommand": "bash .devcontainer/postCreateCommand.sh",
  "postAttachCommand": "bash .devcontainer/postAttachCommand.sh",

  "containerEnv": {
    "NODE_ENV": "development",
    // The container exists only to work on this checkout.
    "MISE_TRUSTED_CONFIG_PATHS": "${containerWorkspaceFolder}"
  },

  // The base image's login profile puts its own Node.js and pnpm first, so
  // only remoteEnv can put the shims ahead of them. This PATH replaces the
  // login shell's, so it re-adds the pre-commit feature's directory, which
  // only /etc/bash.bashrc adds.
  "remoteEnv": {
    "PATH": "/home/node/.local/share/mise/shims:${containerEnv:PATH}:/usr/local/py-utils/bin"
  },

  // pnpm store configuration
  // ⚠️ DO NOT use volume mounts for pnpm store (e.g., "source=genshin-pnpm-store,target=...")
  // Named Docker volumes mount as root, causing EACCES permission errors for the 'node' user.
  // Solution: Use default store location. First pnpm install is slower, but cache works normally after.

  "remoteUser": "node"
}
