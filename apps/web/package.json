{
  "name": "@genshin/web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "lint:css": "stylelint 'src/**/*.css' --fix",
    "preview": "vite preview",
    "schemas:export": "tsx scripts/export-schemas.ts",
    "test": "vitest run",
    "verify": "bash scripts/verify-build-output.sh && tsx scripts/verify-bundle-stats.ts",
    "typecheck": "tsc -b --noEmit && tsc --project tsconfig.scripts.json --noEmit"
  },
  "dependencies": {
    "@genshin/collection-json": "workspace:*",
    "@genshin/domain": "workspace:*",
    "@genshin/game-data": "workspace:*",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-dropdown-menu": "2.1.24",
    "@radix-ui/react-popover": "1.1.23",
    "@radix-ui/react-slot": "1.3.3",
    "@tanstack/react-query": "5.101.4",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "firebase": "12.18.0",
    "lucide-react": "1.33.0",
    "motion": "13.1.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router-dom": "7.18.2",
    "sonner": "2.0.8",
    "tailwind-merge": "3.6.0",
    "zod": "4.4.3",
    "zustand": "5.0.15"
