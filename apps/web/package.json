{
  "name": "@genshin/web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "brand-assets": "tsx scripts/generate-brand-assets.ts",
    "build": "tsc -b && vite build",
    "lint": "eslint . --max-warnings=0",
    "lint:css": "stylelint 'src/**/*.css' --fix --max-warnings 0",
    "preview": "vite preview",
    "test": "vitest run",
    "verify": "bash scripts/verify-build-output.sh && tsx scripts/verify-bundle-stats.ts",
    "typecheck": "tsc -b --noEmit && tsc --project tsconfig.scripts.json --noEmit"
  },
  "dependencies": {
    "@firebase/app": "0.16.5",
    "@firebase/auth": "1.13.9",
    "@genshin/collection-json": "workspace:*",
    "@genshin/domain": "workspace:*",
    "@genshin/game-data": "workspace:*",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@radix-ui/react-popover": "1.3.1",
    "@radix-ui/react-slot": "1.5.0",
    "@tanstack/react-query": "5.107.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "lucide-react": "1.72.0",
    "motion": "14.12.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.5",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@codecov/vite-plugin": "2.0.1",
    "@eslint-react/eslint-plugin": "5.30.1",
    "@genshin/eslint-config": "workspace:*",
    "@genshin/tsconfig": "workspace:*",
    "@genshin/vitest-config": "workspace:*",
    "@resvg/resvg-wasm": "2.6.2",
    "@tailwindcss/postcss": "4.3.5",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.9",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitejs/plugin-react": "6.3.0",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "10.14.0",
    "eslint-plugin-jest-dom": "5.10.1",
    "eslint-plugin-jsx-a11y-x": "0.2.0",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "eslint-plugin-testing-library": "7.16.2",
    "globals": "17.14.0",
    "jsdom": "30.1.3",
    "msw": "3.0.5",
    "postcss": "8.5.32",
    "stylelint": "18.0.0",
    "stylelint-config-standard": "41.0.0",
    "tailwindcss": "4.3.5",
    "tailwindcss-animate": "1.0.7",
    "tsx": "4.23.15",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
