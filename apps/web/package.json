    "eslint-plugin-testing-library": "7.16.2",
    "globals": "17.11.0",
    "jsdom": "30.0.1",
    "msw": "2.15.0",
    "postcss": "8.5.26",
    "stylelint": "17.14.1",
    "stylelint-config-standard": "40.0.0",
    "tailwindcss": "4.3.3",
    "tailwindcss-animate": "1.0.7",
    "tsx": "4.23.12",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vite": "8.2.2",
    "vitest": "4.1.11"
