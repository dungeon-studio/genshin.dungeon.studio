# Firebase client configuration
# Copy this file to .env.local and fill in values from: terraform output firebase_web_app_config
# These are build-time variables — Vite inlines them into the JS bundle.
# Firebase client config is public by design; it is NOT secret.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# API base URL — the origin of the API server (no trailing slash).
# Set per environment at build time; this default targets the local API server.
VITE_API_BASE_URL=http://localhost:8080

# Which deployment this bundle is for: dev, staging, or prod. Non-production
# values badge the app mark in the tab and header, so environments are told
# apart. Unset resolves to dev.
VITE_APP_ENV=dev

# Origin this build is deployed to (no trailing slash). The generated
# robots.txt and sitemap.xml name it, Open Graph URLs resolve against it, and
# only the public origin invites crawlers.
VITE_SITE_ORIGIN=http://localhost:5173
