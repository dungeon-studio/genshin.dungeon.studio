{
  "extends": "@genshin/tsconfig/base.json",
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "outDir": "./dist",
    "rootDir": "./src",
    "types": ["node"],
    "resolveJsonModule": true,
    // tsc-alias rewrites these in the emitted JavaScript so Node can resolve them.
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src"]
}
