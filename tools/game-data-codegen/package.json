{
  "name": "@genshin/game-data-codegen",
  "version": "0.1.0",
  "private": true,
  "description": "Code generators that build @genshin/game-data sources from genshin-db",
  "type": "module",
  "bin": {
    "game-data-codegen": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint . --max-warnings=0",
    "generate": "node ./dist/cli.js"
  },
  "dependencies": {
    "@genshin/game-data": "workspace:*",
    "commander": "15.0.0",
    "genshin-db": "5.2.13"
  },
  "devDependencies": {
    "@genshin/eslint-config": "workspace:*",
    "@genshin/tsconfig": "workspace:*",
    "@types/node": "25.9.5",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "10.9.1",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vitest": "4.1.11"
  }
}
